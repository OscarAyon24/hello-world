        screen.fill(BLACK)
        if quest_menu_open:
            menu_width, menu_height = SCREEN_WIDTH - 80, SCREEN_HEIGHT - 80
            menu_x, menu_y = 40, 40
            menu_bg = pygame.Surface((menu_width, menu_height))
            menu_bg.set_alpha(220)
            menu_bg.fill((30, 30, 30))
            screen.blit(menu_bg, (menu_x, menu_y))
            pygame.draw.rect(screen, GOLD, (menu_x - 2, menu_y - 2, menu_width + 4, menu_height + 4), 2)
            active_title = font.render("Active Quests", True, CYAN)
            completed_title = font.render("Completed Quests", True, YELLOW)
            screen.blit(active_title, (menu_x + 20, menu_y + 20))
            screen.blit(completed_title, (menu_x + menu_width // 2 + 20, menu_y + 20))
            active_quests = [q for q in quests if q["progress"] < q["target"]]
            completed_quests = [q for q in quests if q["progress"] >= q["target"]]
            max_text_width = menu_width // 2 - 40
            if not active_quests:
                no_quests_text = font_quest.render("No active quests", True, WHITE)
                screen.blit(no_quests_text, (menu_x + 20, menu_y + 60))
            for i, quest in enumerate(active_quests):
                status = f"{quest['progress']}/{quest['target']}"
                quest_text = truncate_text(f"{quest['description']} ({status})", font_quest, max_text_width)
                quest_surface = font_quest.render(quest_text, True, WHITE)
                screen.blit(quest_surface, (menu_x + 20, menu_y + 60 + i * 25))
            if not completed_quests:
                no_quests_text = font_quest.render("No completed quests", True, GRAY)
                screen.blit(no_quests_text, (menu_x + menu_width // 2 + 20, menu_y + 60))
            for i, quest in enumerate(completed_quests):
                quest_text = truncate_text(f"{quest['description']} (Done)", font_quest, max_text_width)
                quest_surface = font_quest.render(quest_text, True, GRAY)
                screen.blit(quest_surface, (menu_x + menu_width // 2 + 20, menu_y + 60 + i * 25))
            instr_text = font.render("Press TAB to close menu", True, WHITE)
            screen.blit(instr_text, (menu_x + menu_width // 2 - 60, menu_y + menu_height - 30))
        elif inventory_menu_open:
            draw_inventory_menu(player, font, font_quest)
        else:
            pygame.draw.rect(screen, CEILING_COLOR, (0, 0, SCREEN_WIDTH, SCREEN_HEIGHT // 2))
            pygame.draw.rect(screen, FLOOR_COLOR, (0, SCREEN_HEIGHT // 2, SCREEN_WIDTH, SCREEN_HEIGHT // 2))
            walls = cast_rays(player)
            for x, height, color in walls:
                pygame.draw.rect(screen, color, (x, (SCREEN_HEIGHT - height) / 2, SCREEN_WIDTH // RAY_COUNT, height))
            draw_sprites(player, enemies + items + npcs)
            minimap_size = 100
            minimap_tile = minimap_size // max(MAP_WIDTH, MAP_HEIGHT)
            minimap = pygame.Surface((minimap_size, minimap_size))
            minimap.fill(BLACK)
            for y in range(MAP_HEIGHT):
                for x in range(MAP_WIDTH):
                    color = DARK_GREEN if game_map[y][x] == 0 else WALL_COLORS.get(game_map[y][x], GRAY)
                    pygame.draw.rect(minimap, color, (x * minimap_tile, y * minimap_tile, minimap_tile, minimap_tile))
            for enemy in enemies:
                ex = int(enemy.x * minimap_tile)
                ey = int(enemy.y * minimap_tile)
                pygame.draw.circle(minimap, RED if not enemy.is_boss else YELLOW, (ex, ey), 3)
            px = int(player.x * minimap_tile)
            py = int(player.y * minimap_tile)
            pygame.draw.circle(minimap, WHITE, (px, py), 4)
            screen.blit(minimap, (10, 10))
            bar_width, bar_height = 200, 20
            bar_x, bar_y = (SCREEN_WIDTH - bar_width) // 2, SCREEN_HEIGHT - bar_height - 10
            pygame.draw.rect(screen, GRAY, (bar_x, bar_y, bar_width, bar_height))
            health_ratio = max(0, min(1, player.health / 100))
            pygame.draw.rect(screen, RED, (bar_x, bar_y, int(bar_width * health_ratio), bar_height))
            health_text = font.render(f"Health: {player.health}/100", True, WHITE)
            screen.blit(health_text, (bar_x + bar_width // 2 - 40, bar_y + 2))
            if dialogue_timer > 0:
                for i, line in enumerate(dialogue_text):
                    dialogue_surface = font.render(line, True, WHITE)
                    screen.blit(dialogue_surface, (SCREEN_WIDTH // 2 - 100, SCREEN_HEIGHT - 60 - len(dialogue_text) * 20 + i * 20))
                dialogue_timer -= 1
            crosshair_color = WHITE
            for enemy in enemies:
                dist = math.hypot(player.x - enemy.x, player.y - enemy.y)
                angle = abs(math.atan2(enemy.y - player.y, enemy.x - player.x) - player.angle)
                if dist < 3.0 and angle < 1.2 * FOV:
                    crosshair_color = RED
                    break
            pygame.draw.line(screen, crosshair_color, (SCREEN_WIDTH // 2 - 10, SCREEN_HEIGHT // 2), (SCREEN_WIDTH // 2 + 10, SCREEN_HEIGHT // 2), 2)
            pygame.draw.line(screen, crosshair_color, (SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 10), (SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 10), 2)
            if player.has_sword:
                screen.blit(sprite_surfaces["sword"], (SCREEN_WIDTH - 40, SCREEN_HEIGHT - 40))
            if player.has_armor:
                screen.blit(sprite_surfaces["armor"], (SCREEN_WIDTH - 80, SCREEN_HEIGHT - 40))
            if player.shields > 0:
                screen.blit(sprite_surfaces["shield"], (SCREEN_WIDTH - 120, SCREEN_HEIGHT - 40))
            if player.bombs > 0:
                screen.blit(sprite_surfaces["bomb"], (SCREEN_WIDTH - 160, SCREEN_HEIGHT - 40))

        pygame.display.flip()
        clock.tick(FPS)
        await asyncio.sleep(1.0 / FPS)

    pygame.quit()

if platform.system() == "Emscripten":
    asyncio.ensure_future(main())
else:
    if __name__ == "__main__":
        asyncio.run(main())