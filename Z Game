# Startup screen
async def show_start_screen(big_font, prompt_font):
    started = False
    clock = pygame.time.Clock()
    while not started:
        screen.fill(BLACK)
        title = big_font.render("Hyrule’s First Strike", True, GOLD)
        prompt = prompt_font.render("Press ENTER to Start", True, CYAN)
        screen.blit(title, (SCREEN_WIDTH // 2 - title.get_width() // 2, SCREEN_HEIGHT // 2 - 50))
        screen.blit(prompt, (SCREEN_WIDTH // 2 - prompt.get_width() // 2, SCREEN_HEIGHT // 2 + 10))
        pygame.display.flip()
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                return False
            if event.type == pygame.KEYDOWN and event.key == pygame.K_RETURN:
                started = True
        clock.tick(15)
        await asyncio.sleep(0.02)
    return True

# Initialize game objects
def reset_game():
    player = Player(2.5, 2.5)
    enemies = [Enemy(random.randint(1, MAP_WIDTH - 2), random.randint(1, MAP_HEIGHT - 2)) for _ in range(3)]
    enemies.append(Enemy(MAP_WIDTH - 2, 2, is_boss=True))
    items = [
        Item(random.randint(1, MAP_WIDTH - 2), random.randint(1, MAP_HEIGHT - 2), random.choice(["rupee", "heart", "shield", "bomb"])) for _ in range(6)
    ]
    items.extend([
        Item(random.randint(1, MAP_WIDTH - 2), random.randint(1, MAP_HEIGHT - 2), "sword"),
        Item(random.randint(1, MAP_WIDTH - 2), random.randint(1, MAP_HEIGHT - 2), "armor")
    ])
    npcs = [
        NPC(8, 8, "Villager", ["Find my lost sword!", "It's in the forest."], quest_item="sword"),
        NPC(9, 9, "Elder", ["Defeat the boss in the mountains!", "Shield hero."], quest_item=None)
    ]
    quests = [
        {"id": "main", "goal": "defeat_boss", "target": 1, "progress": 0, "description": "Defeat the boss"},
        {"id": "side", "goal": "return_sword", "target": 1, "progress": 0, "description": "Return sword to Villager"}
    ]
    return player, enemies, items, npcs, quests, False, False

# Game loop
async def main():
    clock = pygame.time.Clock()
    font = pygame.font.SysFont(None, 24)
    font_quest = pygame.font.SysFont(None, 20)
    big_font = pygame.font.SysFont(None, 48)
    prompt_font = pygame.font.SysFont(None, 28)

    # Initial game state
    player, enemies, items, npcs, quests, quest_menu_open, inventory_menu_open = reset_game()
    dialogue_text = []
    dialogue_timer = 0

    # Show startup screen
    if not await show_start_screen(big_font, prompt_font):
        return

    running = True
    while running:
        # Input handling
        tab_pressed = False
        inventory_pressed = False
        bomb_used = False
        interact_pressed = False
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            elif event.type == pygame.KEYUP:
                if event.key == pygame.K_TAB:
                    tab_pressed = True
                elif event.key == pygame.K_i:
                    inventory_pressed = True
                    inventory_menu_open = not inventory_menu_open
                    print(f"I key toggled inventory: {inventory_menu_open}")
                    if inventory_menu_open:
                        quest_menu_open = False
                elif event.key == pygame.K_o:
                    inventory_menu_open = False
                    print("Inventory force-closed with O")
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_b:
                    bomb_used = player.use_bomb()
                elif event.key == pygame.K_e:
                    interact_pressed = True
                elif event.key == pygame.K_SPACE:
                    player.attack()
        if tab_pressed:
            quest_menu_open = not quest_menu_open
            if quest_menu_open:
                inventory_menu_open = False
                print(f"Quest menu toggled, Inventory: {inventory_menu_open}")

        # Update (only if no menus are open)
        if not (quest_menu_open or inventory_menu_open):
            keys = pygame.key.get_pressed()
            dx, dy, da = 0, 0, 0
            if keys[pygame.K_w] or keys[pygame.K_UP]:
                dx = 1
            if keys[pygame.K_s] or keys[pygame.K_DOWN]:
                dx = -1
            if keys[pygame.K_a] or keys[pygame.K_LEFT]:
                da = -1
            if keys[pygame.K_d] or keys[pygame.K_RIGHT]:
                da = 1
            player.move(dx, dy)
            player.turn(da)
            player.update()

            # Enemy updates
            enemies_to_remove = []
            for enemy in enemies[:]:
                enemy.move_toward(player)
                enemy.attack(player)
                enemy.attack_cooldown = max(0, enemy.attack_cooldown - 1)
                if player.attacking or bomb_used:
                    dist = math.hypot(player.x - enemy.x, player.y - enemy.y)
                    if (player.attacking and dist < 3.0 and abs(math.atan2(enemy.y - player.y, enemy.x - player.x) - player.angle) < 1.2 * FOV) or (bomb_used and dist < 3.0):
                        damage = player.attack_damage * (5 if bomb_used else 1)
                        enemy.health -= damage
                        enemy.flash_timer = 5
                        print(f"Hit {enemy.name} for {damage} damage, health now {enemy.health}")
                        if enemy.health <= 0:
                            enemies_to_remove.append(enemy)
                            if enemy.is_boss:
                                for quest in quests:
                                    if quest["goal"] == "defeat_boss":
                                        quest["progress"] = 1
                                        items.append(Item(enemy.x, enemy.y, "heart"))
                                        SOUNDS["quest"].play()
            for enemy in enemies_to_remove:
                enemies.remove(enemy)

            # Item collection
            for item in items[:]:
                dist = math.hypot(player.x - item.x, player.y - item.y)
                if dist < 0.5:
                    SOUNDS["pickup"].play()
                    if item.type == "rupee":
                        player.rupees += 1
                    elif item.type == "heart":
                        player.health = min(player.health + 20, 100)
                    elif item.type == "sword":
                        player.has_sword = True
                        for quest in quests:
                            if quest["goal"] == "return_sword":
                                quest["progress"] = 1
                    elif item.type == "armor":
                        player.has_armor = True
                    elif item.type == "shield":
                        player.shields += 1
                    elif item.type == "bomb":
                        player.bombs += 1
                    items.remove(item)

            # Quest completion
            for npc in npcs:
                if npc.quest_item and math.hypot(player.x - npc.x, player.y - npc.y) < 1.0:
                    if player.has_sword and npc.quest_item == "sword" and npc.dialogue != ["Thank you! Here's a reward."]:
