# Raycasting function
def cast_rays(player):
    walls = []
    for i in range(RAY_COUNT):
        ray_angle = player.angle - FOV / 2 + (i / RAY_COUNT) * FOV
        x, y = player.x, player.y
        sin_a, cos_a = math.sin(ray_angle), math.cos(ray_angle)
        for depth in range(int(MAX_DEPTH * 10)):
            depth /= 10
            target_x = x + cos_a * depth
            target_y = y + sin_a * depth
            tile_x, tile_y = int(target_x), int(target_y)
            if tile_x < 0 or tile_x >= MAP_WIDTH or tile_y < 0 or tile_y >= MAP_HEIGHT:
                break
            if game_map[tile_y][tile_x] != 0:
                depth *= math.cos(ray_angle - player.angle)
                height = SCREEN_HEIGHT / (depth + 0.0001) * 2
                wall_height = min(height, SCREEN_HEIGHT)
                wall_type = game_map[tile_y][tile_x]
                color = WALL_COLORS.get(wall_type, GRAY)
                shade = max(0, 255 - depth * 20)
                color = tuple(min(255, c * shade / 255) for c in color)
                texture = (target_x % 1 + target_y % 1) * 255
                texture_color = (min(255, color[0] + texture // 8), min(255, color[1] + texture // 8), min(255, color[2] + texture // 8))
                walls.append((i * (SCREEN_WIDTH // RAY_COUNT), wall_height, texture_color))
                break
    return walls

# Draw sprites
def draw_sprites(player, objects):
    sprites = []
    for obj in objects:
        dx = obj.x - player.x
        dy = obj.y - player.y
        dist = math.hypot(dx, dy)
        if dist < MAX_DEPTH and dist > 0.1:
            theta = math.atan2(dy, dx) - player.angle
            if theta < -math.pi:
                theta += 2 * math.pi
            if theta > math.pi:
                theta -= 2 * math.pi
            if abs(theta) < FOV / 2:
                screen_x = (theta / FOV + 0.5) * SCREEN_WIDTH
                size = SCREEN_HEIGHT / (dist * math.cos(theta)) * 0.5
                size = min(size, SCREEN_HEIGHT / 2)
                sprite_type = obj.type if hasattr(obj, "type") else obj.name.lower()
                surface = sprite_surfaces[sprite_type].copy()
                if hasattr(obj, "flash_timer") and obj.flash_timer > 0:
                    flash_surface = pygame.Surface(surface.get_size(), pygame.SRCALPHA)
                    flash_surface.fill((255, 0, 0, 180))
                    surface.blit(flash_surface, (0, 0), special_flags=pygame.BLEND_RGBA_ADD)
                    obj.flash_timer -= 1
                y_offset = getattr(obj, "anim_offset", 0)
                sprites.append((dist, screen_x - size / 2, size, surface, y_offset))
    sprites.sort(key=lambda x: x[0], reverse=True)
    for dist, x, size, surface, y_offset in sprites:
        scaled = pygame.transform.scale(surface, (int(size), int(size)))
        screen.blit(scaled, (x, SCREEN_HEIGHT / 2 - size / 2 + y_offset))

# Text truncation
def truncate_text(text, font, max_width):
    if font.size(text)[0] <= max_width:
        return text
    while font.size(text + "...")[0] > max_width and len(text) > 0:
        text = text[:-1]
    return text + "..."

