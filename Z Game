# Precompute sprite surfaces with patterns
def create_sprite_surface(name, size, color):
    surface = pygame.Surface((size, size), pygame.SRCALPHA)
    surface.fill(color)
    if name in ["player", "enemy", "boss", "villager", "elder"]:
        pygame.draw.circle(surface, (255, 255, 255, 100), (size // 2, size // 2), size // 4)
    elif name in ["rupee", "heart", "shield", "bomb"]:
        pygame.draw.rect(surface, (255, 255, 255, 100), (size // 4, size // 4, size // 2, size // 2))
    elif name in ["sword", "armor"]:
        pygame.draw.line(surface, (255, 255, 255, 100), (size // 4, size // 4), (size * 3 // 4, size * 3 // 4), 2)
    return surface

sprite_surfaces = {
    name: create_sprite_surface(name, 24, color) for name, color in SPRITES.items()
}
sprite_surfaces["boss"] = create_sprite_surface("boss", 48, YELLOW)

# Sound generation
def create_sound(frequency, duration, volume=1000):
    samples = np.array([[volume * math.sin(2 * math.pi * frequency * t / 44100) for t in range(int(44100 * duration))] for _ in range(2)], dtype=np.int16).T
    return pygame.sndarray.make_sound(np.ascontiguousarray(samples))

SOUNDS = {
    "attack": create_sound(440, 0.1),
    "pickup": create_sound(880, 0.05),
    "quest": create_sound(660, 0.2),
    "bomb": create_sound(220, 0.3)
}

# Player class
class Player:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.angle = 0
        self.speed = 0.1
        self.turn_speed = 0.12
        self.health = 100
        self.rupees = 0
        self.attacking = False
        self.attack_duration = 0
        self.has_sword = False
        self.has_armor = False
        self.shields = 0
        self.bombs = 0
        self.attack_damage = 1
        self.defense = 0
        self.anim_offset = 0

    def move(self, dx, dy):
        move_x = dx * math.cos(self.angle) - dy * math.sin(self.angle)
        move_y = dx * math.sin(self.angle) + dy * math.cos(self.angle)
        new_x = self.x + move_x * self.speed
        new_y = self.y + move_y * self.speed
        tile_x, tile_y = int(new_x), int(new_y)
        if 0 <= tile_x < MAP_WIDTH and 0 <= tile_y < MAP_HEIGHT and game_map[tile_y][tile_x] == 0:
            self.x = new_x
            self.y = new_y

    def turn(self, da):
        self.angle = (self.angle + da * self.turn_speed) % (2 * math.pi)

    def attack(self):
        self.attacking = True
        self.attack_duration = 10
        SOUNDS["attack"].play()

    def use_bomb(self):
        if self.bombs > 0:
            self.bombs -= 1
            SOUNDS["bomb"].play()
            return True
        return False

    def update(self):
        if self.attack_duration > 0:
            self.attack_duration -= 1
            self.attacking = self.attack_duration > 0
        self.attack_damage = 4 if self.has_sword else 2
        self.defense = 1 if self.has_armor else 0
        self.anim_offset = math.sin(pygame.time.get_ticks() * 0.005) * 5

# Enemy class
class Enemy:
    def __init__(self, x, y, is_boss=False):
        self.x = x + 0.5
        self.y = y + 0.5
        self.is_boss = is_boss
        self.health = 8 if is_boss else 5
        self.speed = 0.05 if is_boss else 0.1
        self.attack_cooldown = 0
        self.size = 0.5
        self.name = "boss" if is_boss else "enemy"
        self.flash_timer = 0
        self.anim_offset = 0

    def move_toward(self, player):
        dx = player.x - self.x
        dy = player.y - self.y
        dist = math.hypot(dx, dy)
        if dist < 6.0 and dist > 0.5:
            angle = math.atan2(dy, dx)
            new_x = self.x + math.cos(angle) * self.speed
            new_y = self.y + math.sin(angle) * self.speed
            tile_x, tile_y = int(new_x), int(new_y)
            if 0 <= tile_x < MAP_WIDTH and 0 <= tile_y < MAP_HEIGHT and game_map[tile_y][tile_x] == 0:
                self.x = new_x
                self.y = new_y
        self.anim_offset = math.sin(pygame.time.get_ticks() * 0.003) * 5

    def attack(self, player):
        if self.attack_cooldown <= 0:
            dist = math.hypot(player.x - self.x, player.y - self.y)
            if dist < self.size + 0.5:
                damage = 30 if self.is_boss else 10
                if player.shields > 0:
                    player.shields -= 1
                    SOUNDS["pickup"].play()
                else:
                    player.health -= max(1, damage - player.defense)
                self.attack_cooldown = 30

